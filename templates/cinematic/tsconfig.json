{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "types": []
  },
  "include": ["*.ts", "*.tsx", "animation/*.ts", "camera/*.ts", "stories/*.ts", "stories/*.tsx", "story-templates/*.ts", "story-templates/*.tsx"],
  "exclude": ["check-shots.ts", "*.bundle.mjs"]
}
